# =============================================================================
# poc-rfc-jco · conexión RFC a SAP desde fuera de BTP
#
#   cp .env.example .env   y completar los campos marcados [BASIS]
#   El .env NO se versiona.
# =============================================================================

# --- Sistema SAP -------------------------------------------------------------

# [INFERIDO] Host del servidor de aplicación ABAP.
# En el portafolio aparecen estos dos, del puerto HTTPS del ICM:
#     QAS -> vhcpvqs4ci.buenaventura.pe
#     PRD -> vhcpvps4ci.buenaventura.pe
# Para la POC usar QAS. Confirmar con Basis que el host RFC sea el mismo que el
# web: en instalaciones con varios servidores de aplicación puede no serlo.
JCO_ASHOST=vhcpvqs4ci.buenaventura.pe

# [INFERIDO] Número de sistema, dos dígitos.
# El ICM responde en 44300, y el patrón de SAP es 443<nn>, así que nn = 00.
# Confirmar: de este número dependen los puertos que hay que abrir.
JCO_SYSNR=00

# [BASIS] Mandante, tres dígitos. No aparece en ningún sitio del código porque
# hoy vive en la configuración del destination en BTP.
JCO_CLIENT=

# --- Usuario -----------------------------------------------------------------

# [BASIS] Usuario de comunicación con autorización RFC.
# Debe ser de tipo COMMUNICATION o SYSTEM, no de diálogo: un usuario de diálogo
# bloquea el uso concurrente y caduca la clave.
JCO_USER=

# [BASIS] Clave del usuario.
JCO_PASSWD=

# Idioma de la sesión.
JCO_LANG=ES

# --- Destino -----------------------------------------------------------------

# Nombre lógico. Es el mismo que usa backend_zinvoice, así que al replicarlo
# en los backends no hay que tocar los sitios de llamada.
JCO_DESTINO=S4HANA_DEST_RFC

# --- Pool de conexiones ------------------------------------------------------

JCO_POOL_CAPACITY=3
JCO_PEAK_LIMIT=10

# --- SNC ---------------------------------------------------------------------

# [BASIS] 0 = sin cifrado SNC. Si el sistema lo exige, ponerlo en 1 y pedir
# además la librería criptográfica y el nombre SNC del servidor: eso agrega
# trabajo a la POC y conviene saberlo antes de empezar.
JCO_SNC_MODE=0

# --- Contenedor --------------------------------------------------------------

PORT=8080
JDK=21

# Subir a DEBUG sólo para diagnosticar: el log de JCo es muy verboso.
JCO_LOG_LEVEL=INFO

# --- Trazas ------------------------------------------------------------------

# Vuelca en el log los parámetros que se mandan y la tabla que responde. Es lo
# que sirve para comparar contra lo que hace el backend en BTP, y lo que delató
# que I_FECHA se truncaba. Encendido: en una sonda, ver qué viajó es el objetivo.
# Al replicar esto en los backends de producción conviene revisarlo: el volcado
# incluye los datos de negocio que viajaron.
JCO_TRACE_RFC=true

# Tope de filas por tabla en ese volcado. Una tabla de un año son miles.
JCO_TRACE_MAX_FILAS=10

# Trace nativo de JCo, 0 a 10. Otra cosa: es el nivel del protocolo RFC
# —handshake, codepage, tiempos por segmento— y escribe archivos JCO*.trc en
# JCO_TRACE_PATH, no en el log. Con 4 alcanza para casi todo.
# Encenderlo sólo mientras se diagnostica: los archivos crecen rápido y guardan
# los datos de la conexión. El .gitignore ya los excluye.
JCO_TRACE_LEVEL=0

# Dónde sale ese trace:
#   archivo  -> JCO*.trc en JCO_TRACE_PATH, dentro del contenedor
#   consola  -> por la salida estándar, junto al resto del log
# Con 'consola' JCo deja de escribir los .trc: no hay que ir a buscarlos con
# docker exec ni montar un volumen para verlos.
JCO_TRACE_DESTINO=archivo
JCO_TRACE_PATH=/app/trace

# Severidad con la que sale ese trace por consola. Baja a DEBUG porque en
# niveles altos son miles de líneas; subirla a INFO lo hace visible sin tocar
# el nivel del resto de JCo.
JCO_TRACE_LOG_LEVEL=DEBUG
