<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.5</version>
    <relativePath/>
  </parent>

  <groupId>pe.bnv</groupId>
  <artifactId>poc-rfc-jco</artifactId>
  <version>1.0.0</version>
  <name>poc-rfc-jco</name>
  <description>Sonda de conectividad RFC hacia SAP desde fuera de BTP</description>

  <properties>
    <java.version>21</java.version>
    <sapjco.version>3.1.14</sapjco.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      sapjco3 es software licenciado por SAP: no está en Maven Central y no se
      puede redistribuir. Se resuelve desde libs/ para que el build no dependa
      de un paso previo de instalación en el repositorio local.
    -->
    <dependency>
      <groupId>com.sap.conn.jco</groupId>
      <artifactId>sapjco3</artifactId>
      <version>${sapjco.version}</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/libs/sapjco3.jar</systemPath>
    </dependency>
  </dependencies>

  <build>
    <finalName>poc-rfc-jco</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- sin esto, una dependencia system no entra en el jar ejecutable -->
          <includeSystemScope>true</includeSystemScope>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
